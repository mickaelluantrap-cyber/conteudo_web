    {
        "id": "createUserFn",
        "type": "function",
        "z": "db35a1b23324bf64",
        "name": "Criar Usuário",
        "func": "let fs = global.get('fs');\n\nlet users = [];\n\ntry {\n    users = JSON.parse(fs.readFileSync('users.json'));\n} catch (e) {}\n\nusers.push(msg.payload);\n\nfs.writeFileSync('users.json', JSON.stringify(users, null, 2));\n\nmsg.payload = {status: 'ok', message: 'Usuário criado!'};\nreturn msg;",
