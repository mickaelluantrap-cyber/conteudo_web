    {
        "id": "updateUserFn",
        "type": "function",
        "z": "db35a1b23324bf64",
        "name": "Alterar",
        "func": "let fs = global.get('fs');\nlet users = JSON.parse(fs.readFileSync('users.json'));\n\nlet email = msg.payload.email;\n\nlet user = users.find(u => u.email === email);\n\nif (user) {\n    user.nome = msg.payload.nome;\n    user.nascimento = msg.payload.nascimento;\n}\n\nfs.writeFileSync('users.json', JSON.stringify(users, null, 2));\n\nmsg.payload = {status: 'ok', message: 'Usuário atualizado'};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 340,
        "y": 240,
        "wires": [
            [
                "resp"
            ]
        ]
    },
