    {
        "id": "deleteUserFn",
        "type": "function",
        "z": "db35a1b23324bf64",
        "name": "Remover",
        "func": "let fs = global.get('fs');\nlet users = JSON.parse(fs.readFileSync('users.json'));\n\nusers = users.filter(u => u.email !== msg.payload.email);\n\nfs.writeFileSync('users.json', JSON.stringify(users, null, 2));\n\nmsg.payload = {status: 'ok', message: 'Usuário removido'};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 340,
        "y": 320,
        "wires": [
            [
                "resp"
            ]
        ]
    },
